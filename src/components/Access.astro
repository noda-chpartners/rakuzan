---
import { Icon } from 'astro-icon/components';

const mapQuery = encodeURIComponent('千葉県柏市増尾8-21-6');
const mapSrc = `https://maps.google.com/maps?q=${mapQuery}&hl=ja&z=16&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
---

<section class="section access" id="access">
  <div class="container--wide">
    <div class="section__head reveal">
      <p class="section__en">Access</p>
      <h2 class="section__ja">アクセス</h2>
      <div class="section__rule"></div>
    </div>

    <div class="access__grid">
      <div class="access__copy reveal">
        <p class="access__address">千葉県柏市増尾8-21-6</p>
        <ul>
          <li>
            <Icon name="lucide:train-front" />
            <span>東武野田線 逆井駅・増尾駅から徒歩約18分</span>
          </li>
          <li>
            <Icon name="lucide:navigation" />
            <span>逆井駅東口からバス約5分、下車後徒歩約1分</span>
          </li>
        </ul>
        <a class="access__link" href={mapLink} target="_blank" rel="noreferrer">
          Google マップで見る
        </a>
      </div>

      <div class="access__map reveal">
        <iframe
          title="茶寮洛山の地図"
          src={mapSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .access__grid {
    display: grid;
    gap: 1.75rem;
  }

  .access__address {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    letter-spacing: 0.12em;
    margin-bottom: 1.4rem;
  }

  .access__copy ul {
    display: grid;
    gap: 0.9rem;
  }

  .access__copy li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    color: var(--ink-soft);
  }

  .access__copy [data-icon] {
    color: var(--gold);
    margin-top: 0.25rem;
  }

  .access__link {
    display: inline-block;
    margin-top: 1.6rem;
    padding: 0.85rem 1.4rem;
    border: 1px solid var(--ink);
    letter-spacing: 0.16em;
    font-size: 0.82rem;
    transition: background 0.3s var(--ease), color 0.3s var(--ease);
  }

  .access__link:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .access__map {
    min-height: 18rem;
    background: var(--paper-deep);
  }

  .access__map iframe {
    width: 100%;
    height: 100%;
    min-height: 18rem;
    border: 0;
    filter: grayscale(0.25) contrast(0.95);
  }

  @media (min-width: 900px) {
    .access__grid {
      grid-template-columns: 0.7fr 1.3fr;
      gap: 2.5rem;
      align-items: center;
    }

    .access__map,
    .access__map iframe {
      min-height: 24rem;
    }
  }
</style>
